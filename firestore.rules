rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isCollabParticipant() {
      return isAuthenticated() &&
             (request.auth.uid == resource.data.brandId ||
              request.auth.uid == resource.data.influencerId);
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.email == 'bechagraamine@gmail.com';
    }

    // La messagerie brand <-> influenceur est verrouillée tant que la marque n'a pas payé
    // (voir stripe_webhook_handler, qui passe paymentUnlocked à true). Les conversations
    // créées avant l'introduction de cette règle restent débloquées (pas de régression pour
    // les échanges déjà en cours).
    function isMessagingUnlocked(convData) {
      return convData.paymentUnlocked == true || convData.createdAt < timestamp.date(2026, 9, 7);
    }

    // Données personnelles : jamais dans les profils publics (lisibles par tout le monde),
    // mais dans {collection}/{uid}/private/profile. Liste synchronisée avec
    // src/utils/privateProfile.js et PRIVATE_PROFILE_FIELDS dans functions/main.py.
    function influencerPrivateFields() {
      return ['name', 'email', 'phone'];
    }
    function brandPrivateFields() {
      return ['name', 'email', 'fullName', 'contactPerson', 'phone', 'address', 'siret'];
    }

    // Règles pour les influenceurs
    match /influencers/{influencerId} {
      // Tout le monde peut lire les profils d'influenceurs (profil public uniquement)
      allow read: if true;
      // Création du profil par l'influenceur lui-même, toujours non approuvé au départ,
      // sans données personnelles (elles vont dans private/profile)
      allow create: if isOwner(influencerId) &&
                       request.resource.data.approved == false &&
                       !request.resource.data.keys().hasAny(influencerPrivateFields());
      // L'influenceur peut modifier son profil, sauf le champ "approved" (réservé à l'admin)
      // et sans y (ré)écrire de données personnelles
      allow update: if isAdmin() ||
                       (isOwner(influencerId) &&
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['approved']) &&
                        !request.resource.data.diff(resource.data).affectedKeys().hasAny(influencerPrivateFields()));
      allow delete: if isOwner(influencerId) || isAdmin();

      // Nom, email, téléphone : titulaire du compte et admin uniquement
      match /private/{docId} {
        allow read: if isOwner(influencerId) || isAdmin();
        allow create, update: if isOwner(influencerId);
        allow delete: if isOwner(influencerId) || isAdmin();
      }
    }

    // Coordonnées bancaires (RIB) des influenceurs: jamais publiques,
    // uniquement lisibles/modifiables par le titulaire, et lisibles par l'admin
    // pour effectuer les virements manuels.
    match /bankDetails/{influencerId} {
      allow read, write: if isOwner(influencerId);
      allow read: if isAdmin();
    }
    
    // Règles pour les marques
    match /brands/{brandId} {
      // Tout le monde peut lire les profils de marques (profil public uniquement)
      allow read: if true;
      // Seule la marque peut créer/modifier son propre profil, sans données personnelles
      allow create: if isOwner(brandId) &&
                       !request.resource.data.keys().hasAny(brandPrivateFields());
      allow update: if isOwner(brandId) &&
                       !request.resource.data.diff(resource.data).affectedKeys().hasAny(brandPrivateFields());
      // L'admin peut aussi supprimer un compte marque
      allow delete: if isOwner(brandId) || isAdmin();

      // Email, nom complet, téléphone, adresse, SIRET : titulaire du compte et admin uniquement
      match /private/{docId} {
        allow read: if isOwner(brandId) || isAdmin();
        allow create, update: if isOwner(brandId);
        allow delete: if isOwner(brandId) || isAdmin();
      }
    }
    
    // Règles pour les collaborations
    match /collaborations/{collaborationId} {
      // Les marques et influenceurs peuvent lire leurs propres collaborations
      // L'admin peut tout lire pour gérer les virements manuels (panel Admin)
      allow read: if isCollabParticipant() || isAdmin();

      // Sécurité paiement: création/mise à jour/suppression gérées uniquement côté serveur (Admin SDK / Cloud Functions).
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // Sessions de paiement Stripe: privées côté serveur uniquement.
    match /paymentSessions/{sessionId} {
      allow read, write: if false;
    }

    // Codes de vérification email: générés et vérifiés uniquement côté serveur (Cloud Functions).
    match /emailVerificationCodes/{userId} {
      allow read, write: if false;
    }
    
    function conversationData(conversationId) {
      return get(/databases/$(database)/documents/conversations/$(conversationId)).data;
    }

    function isConversationParticipant(conversationId) {
      return request.auth.uid == conversationData(conversationId).brandId ||
             request.auth.uid == conversationData(conversationId).influencerId;
    }

    // Dépôt de vidéo : seul l'influenceur de la conversation peut livrer une vidéo, qui
    // part toujours en attente de validation par la marque.
    function isValidDeliveryCreate(conversationId) {
      return request.resource.data.get('type', 'text') != 'video_delivery' ||
             (request.auth.uid == conversationData(conversationId).influencerId &&
              request.resource.data.reviewStatus == 'pending');
    }

    // Validation d'une vidéo par la marque : uniquement les champs de revue, une seule fois.
    function isValidDeliveryReview(conversationId) {
      return resource.data.get('type', 'text') == 'video_delivery' &&
             resource.data.reviewStatus == 'pending' &&
             request.auth.uid == conversationData(conversationId).brandId &&
             request.resource.data.reviewStatus in ['approved', 'changes_requested'] &&
             request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['reviewStatus', 'reviewFeedback', 'reviewedAt', 'read']);
    }

    // Règles pour les conversations
    match /conversations/{conversationId} {
      // Les participants peuvent lire leurs conversations
      allow read: if isAuthenticated() &&
                     (request.auth.uid == resource.data.brandId ||
                      request.auth.uid == resource.data.influencerId);
      
      // Les marques peuvent créer des conversations
      allow create: if isAuthenticated() &&
                       request.auth.uid == request.resource.data.brandId;
      
      // Les participants peuvent mettre à jour les conversations (dernier message), mais
      // uniquement une fois qu'un paiement a été sécurisé pour cette relation brand/influenceur.
      allow update: if isAuthenticated() &&
                       (request.auth.uid == resource.data.brandId ||
                        request.auth.uid == resource.data.influencerId) &&
                       isMessagingUnlocked(resource.data);

      // Règles pour les messages dans les conversations
      match /messages/{messageId} {
        // Les participants peuvent lire les messages
        allow read: if isAuthenticated() &&
                       (request.auth.uid == get(/databases/$(database)/documents/conversations/$(conversationId)).data.brandId ||
                        request.auth.uid == get(/databases/$(database)/documents/conversations/$(conversationId)).data.influencerId);

        // Les participants peuvent créer des messages, uniquement après paiement sécurisé
        // (la marque ne peut pas discuter avec l'influenceur tant qu'elle n'a pas payé).
        allow create: if isAuthenticated() &&
                         (request.auth.uid == get(/databases/$(database)/documents/conversations/$(conversationId)).data.brandId ||
                          request.auth.uid == get(/databases/$(database)/documents/conversations/$(conversationId)).data.influencerId) &&
                         request.auth.uid == request.resource.data.senderId &&
                         isMessagingUnlocked(get(/databases/$(database)/documents/conversations/$(conversationId)).data) &&
                         isValidDeliveryCreate(conversationId);

        // - l'expéditeur peut modifier son message, sauf les champs de validation vidéo
        //   (un influenceur ne peut pas valider sa propre vidéo) ;
        // - le destinataire peut seulement le marquer comme lu ;
        // - la marque peut valider une vidéo livrée ou demander des modifications, une seule
        //   fois par version (la vidéo doit être encore « pending »).
        allow update: if isAuthenticated() && (
                         (request.auth.uid == resource.data.senderId &&
                          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['reviewStatus', 'reviewFeedback', 'reviewedAt', 'type'])) ||
                         (isConversationParticipant(conversationId) &&
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])) ||
                         isValidDeliveryReview(conversationId)
                       );
      }
    }
    
    // Règles pour les contacts
    match /contacts/{contactId} {
      // Tout le monde peut créer un contact
      allow create: if true;
      // Messages du formulaire (nom, email, contenu) : admin uniquement. Auparavant
      // n'importe quel utilisateur connecté pouvait les lire, modifier ou supprimer.
      allow read, update, delete: if isAdmin();
    }
    
    // Favoris d'un compte (liste d'identifiants d'influenceurs) : titulaire uniquement.
    match /favorites/{userId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) &&
                               request.resource.data.keys().hasOnly(['ids', 'updatedAt']) &&
                               request.resource.data.ids is list &&
                               request.resource.data.ids.size() <= 500;
    }

    // Règles pour les admins (si tu as une collection admin)
    match /admins/{adminId} {
      allow read, write: if isOwner(adminId);
    }
  }
}
